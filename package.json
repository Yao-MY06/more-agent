{
  "name": "more-agent-resident",
  "version": "0.1.0",
  "description": "常驻 Leader：你只和它对话，它把每条请求交给对应项目的经理会话，经理用 omh 派工人、验收，结果再由它转告你。",
  "author": "Yao-MY06",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yao-MY06/more-agent.git"
  },
  "homepage": "https://github.com/Yao-MY06/more-agent#readme",
  "bugs": {
    "url": "https://github.com/Yao-MY06/more-agent/issues"
  },
  "keywords": [
    "agent",
    "claude-code",
    "orchestration",
    "multi-agent",
    "leader"
  ],
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "check": "npm run lint && npm run typecheck && npm test",
    "eval:memory": "npm run build && node --disable-warning=ExperimentalWarning lib/eval/memory-eval.js",
    "resident": "node --disable-warning=ExperimentalWarning lib/bin/resident.js",
    "desktop": "npm run build && npm --prefix desktop start"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "24.10.1",
    "@types/proper-lockfile": "4.1.4",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
